  {
    "id": "7f2026000000000a",
    "type": "function",
    "z": "e0261109a1000001",
    "name": "API - últimas 360 leituras",
    "func": "const todos = flow.get(\"plantasHistorico\") || [];\nconst parametros = (msg.req && msg.req.query) || {};\nconst limiteRecebido = Number(parametros.limite);\nconst limite = Number.isFinite(limiteRecebido) && limiteRecebido > 0\n    ? Math.min(Math.floor(limiteRecebido), 360) : 60;\nconst planta = parametros.planta;\nconst selecionados = planta === \"Araucaria\" || planta === \"Grandiuva\"\n    ? todos.filter(x => x.planta === planta) : todos;\nmsg.statusCode = 200;\nmsg.headers = { \"Content-Type\": \"application/json; charset=utf-8\", \"Cache-Control\": \"no-store\" };\nmsg.payload = {\n    totalDisponivel: selecionados.length,\n    limite: limite,\n    planta: (planta === \"Araucaria\" || planta === \"Grandiuva\") ? planta : \"todas\",\n    amostras: selecionados.slice(-limite)\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
