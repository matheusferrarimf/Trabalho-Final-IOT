  {
    "id": "7f20260000000002",
    "type": "function",
    "z": "e0261109a1000001",
    "name": "Validar, armazenar e normalizar",
    "func": "// Entrada: JSON enviado por Arduino Mega 2560 via MQTT.\n// Saida: {atual, historico} para o Dashboard 1.0.\nlet entrada = msg.payload;\ntry {\n    if (typeof entrada === \"string\") entrada = JSON.parse(entrada);\n    if (!entrada || typeof entrada !== \"object\" || Array.isArray(entrada)) throw new Error(\"Payload nao e objeto\");\n} catch (erro) {\n    node.warn(\"Telemetria descartada: \" + erro.message);\n    return null;\n}\nif (entrada.planta !== \"Araucaria\" && entrada.planta !== \"Grandiuva\") {\n    node.warn(\"Planta desconhecida: \" + String(entrada.planta));\n    return null;\n}\nconst numero = (valor, minimo, maximo) =>\n    typeof valor === \"number\" && Number.isFinite(valor) && valor >= minimo && valor <= maximo\n        ? Math.round(valor * 10) / 10 : null;\nconst soloValido = entrada.soloValido === true;\nconst luzValida = entrada.planta === \"Grandiuva\" && entrada.luzValida === true;\nconst atual = {\n    planta: entrada.planta,\n    temperatura: numero(entrada.temperatura, -40, 80),\n    umidadeSolo: soloValido ? numero(entrada.umidadeSolo, 0, 100) : null,\n    luminosidade: luzValida ? numero(entrada.luminosidade, 0, 100) : null,\n    soloValido: soloValido,\n    luzValida: luzValida,\n    aquecedor: entrada.aquecedor === true,\n    bomba: entrada.bomba === true,\n    sombreamento: entrada.sombreamento === true,\n    limiarSolo: entrada.planta === \"Araucaria\" ? 35 : 30,\n    limiarTemperatura: 10,\n    limiarLuminosidade: 90,\n    origem: msg.topic === \"unidavi/1025897/iot/plantas/telemetria\" ? \"mqtt\" : \"simulacao\",\n    recebidoEm: new Date().toISOString()\n};\nflow.set(\"plantasAtual\", atual);\nlet historico = flow.get(\"plantasHistorico\") || [];\nhistorico.push(atual);\n// 360 amostras representam aproximadamente uma hora na taxa de 10 s/amostra.\nif (historico.length > 360) historico = historico.slice(-360);\nflow.set(\"plantasHistorico\", historico);\nmsg.payload = { atual: atual, historico: historico.slice(-50) };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
