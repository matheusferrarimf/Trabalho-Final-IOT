  {
    "id": "7f20260000000007",
    "type": "function",
    "z": "e0261109a1000001",
    "name": "API - leitura mais recente",
    "func": "const atual = flow.get(\"plantasAtual\") || null;\nmsg.headers = { \"Content-Type\": \"application/json; charset=utf-8\", \"Cache-Control\": \"no-store\" };\nif (!atual) {\n    msg.statusCode = 503;\n    msg.payload = { erro: \"sem_telemetria\", mensagem: \"Aguardando primeira mensagem MQTT ou simulacao.\" };\n    return msg;\n}\nconst idade = Date.now() - Date.parse(atual.recebidoEm);\nmsg.statusCode = 200;\nmsg.payload = {\n    online: idade >= 0 && idade <= 30000,\n    idadeSegundos: Math.max(0, Math.floor(idade / 1000)),\n    intervaloPublicacaoSegundos: 10,\n    telemetria: atual\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
