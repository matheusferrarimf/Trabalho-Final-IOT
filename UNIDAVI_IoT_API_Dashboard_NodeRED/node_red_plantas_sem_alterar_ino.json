    "func": "// Atualiza situacao do painel mesmo se pararem de chegar mensagens MQTT.\nconst atual = flow.get(\"plantasAtual\") || null;\nconst historico = flow.get(\"plantasHistorico\") || [];\nmsg.payload = { atual: atual, historico: historico.slice(-50) };\nreturn msg;",
