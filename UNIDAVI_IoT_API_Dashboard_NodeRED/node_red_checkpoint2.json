  {
    "id": "7f20260000000002",
    "type": "function",
    "z": "e0261109a1000001",
    "name": "CP2 - validar e separar especies",
    "func": "// Corpo do Function node; incorporado no JSON por scripts/gerar-fluxo-cp2.cjs.\nconst prefixo = 'unidavi/iot/t27/1025897_36728/';\nif (typeof msg.topic !== 'string' || !msg.topic.startsWith(prefixo)) return null;\nconst partes = msg.topic.slice(prefixo.length).split('/');\nconst especie = partes[0];\nif (!['araucaria', 'grandiuva'].includes(especie)) return null;\nconst tipo = partes[1], nome = partes[2];\nlet entrada = Buffer.isBuffer(msg.payload) ? msg.payload.toString() : msg.payload;\nconst especies = flow.get('plantasPorEspecie') || {};\nconst anterior = especies[especie];\nconst atual = anterior ? { ...anterior } : {\n    planta: especie === 'araucaria' ? 'Araucaria' : 'Grandiuva',\n    temperatura: null, umidadeSolo: null, luminosidade: null,\n    soloValido: false, luzValida: false,\n    aquecedor: null, bomba: null, sombreamento: null,\n    limiarSolo: especie === 'araucaria' ? 35 : 30,\n    limiarTemperatura: 10, limiarLuminosidade: 90,\n    mqttOnline: null, recebidoEm: null, origem: 'mqtt'\n};\nconst sensores = {\n    temperatura: { campo: 'temperatura', unidade: 'C', min: -40, max: 80 },\n    'umidade-solo': { campo: 'umidadeSolo', unidade: '%', min: 0, max: 100 },\n    luminosidade: { campo: 'luminosidade', unidade: '%', min: 0, max: 100 }\n};\nlet amostra = false;\ntry {\n    if (tipo === 'status' && partes.length === 2) {\n        if (entrada !== 'online' && entrada !== 'offline') throw Error('Status invalido');\n        atual.mqttOnline = entrada === 'online';\n        atual.statusRecebidoEm = new Date().toISOString();\n    } else if (partes.length === 3 && (tipo === 'sensor' || tipo === 'atuador')) {\n        if (typeof entrada === 'string') entrada = JSON.parse(entrada);\n        if (!entrada || typeof entrada !== 'object' || Array.isArray(entrada)) throw Error('JSON invalido');\n        if (tipo === 'sensor') {\n            const sensor = sensores[nome];\n            if (!sensor) throw Error('Sensor desconhecido');\n            if (entrada.unidade !== sensor.unidade) throw Error('Unidade invalida');\n            const valor = entrada.valor;\n            if (valor !== null && (typeof valor !== 'number' || !Number.isFinite(valor) ||\n                valor < sensor.min || valor > sensor.max)) throw Error('Valor invalido');\n            atual[sensor.campo] = valor;\n            if (nome === 'umidade-solo') atual.soloValido = valor !== null;\n            if (nome === 'luminosidade') {\n                atual.luzValida = especie === 'grandiuva' && valor !== null;\n                if (!atual.luzValida) atual.luminosidade = null;\n            }\n            // Somente sensores novos comprovam atualizacao. Retidos nunca renovam a idade.\n            if (!msg.retain) {\n                atual.recebidoEm = new Date().toISOString();\n                amostra = nome === 'luminosidade'; // ultimo sensor do ciclo do firmware\n            }\n        } else {\n            const campo = { aquecedor: 'aquecedor', irrigacao: 'bomba', sombreamento: 'sombreamento' }[nome];\n            if (!campo || !['ligado', 'desligado'].includes(entrada.estado)) throw Error('Atuador invalido');\n            atual[campo] = entrada.estado === 'ligado';\n        }\n    } else throw Error('Topico fora do contrato');\n} catch (erro) {\n    node.warn('Mensagem descartada: ' + erro.message);\n    return null;\n}\nespecies[especie] = atual;\nflow.set('plantasPorEspecie', especies);\nlet historico = flow.get('plantasHistorico') || [];\nif (amostra) {\n    historico = [...historico, { ...atual }].slice(-360);\n    flow.set('plantasHistorico', historico);\n}\n// Status/atuadores retidos de outra especie nao mudam a ultima leitura da API.\nconst ultima = flow.get('plantasAtual');\nif (tipo === 'sensor' && !msg.retain || ultima && ultima.planta === atual.planta) {\n    flow.set('plantasAtual', atual);\n}\nmsg.payload = { atual, historico: historico.filter(d => d.planta === atual.planta).slice(-50) };\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
