33\" x2=\"280\" y2=\"33\" stroke=\"#cbd5e1\" stroke-dasharray=\"5 6\" stroke-width=\"2\"></line>\n      </svg></div>\n      <div class=\"uv-note\">{{notaLuz}}</div>\n    </div>\n  </div>\n\n  <div class=\"uv-details\">\n    <div class=\"uv-box\">\n      <h2>Estados dos atuadores <small>LEDs do protótipo</small></h2>\n      <div class=\"uv-act\"><div><span>♨️</span><strong>Aquecedor</strong><small>D22</small></div><b ng-class=\"{'uv-on': atual && atual.aquecedor}\">{{estadoAquecedor}}</b></div>\n      <div class=\"uv-act\"><div><span>🚿</span><strong>Bomba de irrigação</strong><small>D24</small></div><b ng-class=\"{'uv-on': atual && atual.bomba}\">{{estadoBomba}}</b></div>\n      <div class=\"uv-act\"><div><span>⛱️</span><strong>Sombreamento</strong><small>D26</small></div><b ng-class=\"{'uv-on': atual && atual.sombreamento}\">{{estadoSombra}}</b></div>\n    </div>\n    <div class=\"uv-box\">\n      <h2>Informações da telemetria <small>{{origem}}</small></h2>\n      <div class=\"uv-info\"><span>Último pacote recebido</span><strong>{{ultimaAtualizacao}}</strong></div>\n      <div class=\"uv-info\"><span>Tempo desde a leitura</span><strong>{{idade}}</strong></div>\n      <div class=\"uv-info\"><span>Histórico exibido</span><strong>{{qtdHistorico}} amostras recentes</strong></div>\n      <div class=\"uv-info\"><span>Transmissão</span><strong>MQTT · porta 1883</strong></div>\n      <div class=\"uv-api\">API JSON: <code>GET /api/plantas/atual</code> e <code>GET /api/plantas/historico</code></div>\n    </div>\n  </div>\n  <div class=\"uv-footer\">Leituras e estados apenas para visualização. Os LEDs são controlados localmente pelo Arduino.</div>\n</div>\n\n<script>\n(function(scope) {\n  // O Dashboard 1.x utiliza AngularJS (nao Vue / Dashboard 2.0).\n  function fmt(n) { return typeof n === 'number' && isFinite(n) ? n.toFixed(1).replace('.', ',') : '—'; }\n  function pontos(hist, planta, campo) {\n    var itens = (hist || []).filter(function(d) {\n      return d && d.planta === planta && typeof d[campo] === 'number' && isFinite(d[campo]);\n    }).slice(-28);\n    if (itens.length < 2) return '';\n    var valores = itens.map(function(d) { return d[campo]; });\n    var baixo = campo === 'temperatura' ? Math.min.apply(null, valores) - 1 : 0;\n    var alto = campo === 'temperatura' ? Math.max.apply(null, valores) + 1 : 100;\n    if (alto - baixo < 1) alto = baixo + 1;\n    return valores.map(function(v, i) {\n      var x = 5 + i * (270 / (valores.length - 1));\n      var y = 57 - (v - baixo) * 48 / (alto - baixo);\n      return x.toFixed(1) + ',' + y.toFixed(1);\n    }).join(' ');\n  }\n  function desenhar(msg) {\n    var dados = msg && msg.payload && typeof msg.payload === 'object' ? msg.payload : {};\n    var atual = dados.atual || null;\n    var hist = Array.isArray(dados.historico) ? dados.historico : [];\n    scope.atual = atual;\n    scope.qtdHistorico = hist.length;\n    scope.valorTemperatura = atual ? fmt(atual.temperatura) : '—';\n    scope.valorSolo = atual && atual.soloValido && atual.umidadeSolo !== null ? fmt(atual.umidadeSolo) : '—';\n    scope.valorLuz = !atual ? '—' : atual.planta === 'Araucaria' ? 'N/A' : atual.luzValida && atual.luminosidade !== null ? fmt(atual.luminosidade) : '—';\n    scope.unidadeSolo = !!(atual && atual.soloValido && typeof atual.umidadeSolo === 'number');\n    scope.unidadeLuz = !!(atual && atual.planta === 'Grandiuva' && atual.luzValida && typeof atual.luminosidade === 'number');\n    scope.percentualSolo = scope.unidadeSolo ? atual.umidadeSolo : 0;\n    scope.percentualLuz = scope.unidadeLuz ? atual.luminosidade : 0;\n    scope.limiarSolo = atual ? atual.limiarSolo + '%' : '35% (Araucária) / 30% (Grandiúva)';\n    scope.notaLuz = !atual ? 'Aguardando dados do sensor' : atual.planta === 'Araucaria' ? 'Não aplicável à Araucária' : atual.luzValida ? 'Sombreamento acima de 90%' : 'LDR não calibrado';\n    scope.estadoAquecedor = !atual || atual.aquecedor === null ? '—' : atual.aquecedor ? 'LIGADO' : 'DESLIGADO';\n    scope.estadoBomba = !atual || atual.bomba === null ? '—' : atual.bomba ? 'LIGADA' : 'DESLIGADA';\n    scope.estadoSombra = !atual || atual.sombreamento === null ? '—' : atual.sombreamento ? 'LIGADO' : 'DESLIGADO';\n    scope.origem = !atual ? 'Aguardando dados' : atual.origem === 'simulacao' ? 'Simulação' : 'Recebido por MQTT';\n    var instante = atual && atual.recebidoEm ? Date.parse(atual.recebidoEm) : NaN;\n    var idadeMs = isFinite(instante) ? Math.max(0, Date.now() - instante) : NaN;\n    scope.idade = isFinite(idadeMs) ? Math.floor(idadeMs / 1000) + ' s' : '—';\n    scope.ultimaAtualizacao = isFinite(instante) ? new Date(instante).toLocaleString('pt-BR') : '—';\n    scope.status = !atual || !atual.recebidoEm ? 'Aguardando dados' : atual.mqttOnline === false ? 'Offline / não selecionada' : !isFinite(idadeMs) || idadeMs > 30000 ? 'Sem atualização' : 'Atualizando';\n    var planta = atual && atual.planta;\n    scope.sparkTemperatura = pontos(hist, planta, 'temperatura');\n    scope.sparkSolo = pontos(hist, planta, 'umidadeSolo');\n    scope.sparkLuz = planta === 'Grandiuva' ? pontos(hist, planta, 'luminosidade') : '';\n  }\n  desenhar(null);\n  scope.$watch('msg', function(msg) { if (msg) desenhar(msg); });\n})(scope);\n</script>\n\n<style>\n#unidavi-cp2-grandiuva.uv-shell {font-family:Roboto,'Segoe UI',Arial,sans-serif;color:#21314a;box-sizing:border-box;padding:4px 2px 12px}\n#unidavi-cp2-grandiuva * {box-sizing:border-box}\n#unidavi-cp2-grandiuva .uv-hero {display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:26px;border-radius:18px;background:linear-gradient(116deg,#112e34,#126457);color:#fff}\n#unidavi-cp2-grandiuva .uv-overline {font-size:10px;font-weight:800;letter-spacing:2px;color:#9ee8cc;margin-bottom:8px}\n#unidavi-cp2-grandiuva h1 {margin:0 0 8px;font-size:26px;font-weight:800;line-height:1.15;letter-spacing:-.5px}\n#unidavi-cp2-grandiuva .uv-hero p{margin:0;color:#d4eee5;font-size:12px}\n#unidavi-cp2-grandiuva .uv-top-flags{display:flex;gap:8px;flex-wrap:wrap}\n#unidavi-cp2-grandiuva .uv-pill{border-radius:22px;padding:8px 11px;font-weight:750;font-size:11px;background:rgba(255,255,255,.15);white-space:nowrap}\n#unidavi-cp2-grandiuva .uv-pill.uv-live{color:#95f3d0}\n#unidavi-cp2-grandiuva .uv-pill.uv-test{color:#ffe3a0}\n#unidavi-cp2-grandiuva .uv-pill.uv-stale{color:#ffbaa6}\n#unidavi-cp2-grandiuva .uv-pill.uv-data-test{border:1px solid rgba(255,255,255,.4)}\n#unidavi-cp2-grandiuva .uv-plants{background:#fff;border:1px solid #dfe8e6;border-radius:14px;padding:17px 20px;margin-top:14px}\n#unidavi-cp2-grandiuva .uv-eyebrow{font-size:10px;letter-spacing:1.3px;font-weight:750;color:#6a7b85}\n#unidavi-cp2-grandiuva .uv-plant-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:10px}\n#unidavi-cp2-grandiuva .uv-plant{display:flex;align-items:center;gap:12px;border-radius:11px;border:2px solid #edf0f0;padding:12px;color:#758590;background:#fafcfc;opacity:.78}\n#unidavi-cp2-grandiuva .uv-plant.uv-active{border-color:#168873;background:#ebfaf5;color:#184f46;opacity:1}\n#unidavi-cp2-grandiuva .uv-plant-icon{font-size:25px;line-height:1.2}\n#unidavi-cp2-grandiuva .uv-plant strong,#unidavi-cp2-grandiuva .uv-plant small{display:block}\n#unidavi-cp2-grandiuva .uv-plant strong{font-size:14px}\n#unidavi-cp2-grandiuva .uv-plant small{font-size:11px;margin-top:4px}\n#unidavi-cp2-grandiuva .uv-plant-help{margin-top:10px;color:#758590;font-size:10px}\n#unidavi-cp2-grandiuva .uv-section-header{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin:20px 0 11px}\n#unidavi-cp2-grandiuva h2{font-size:17px;margin:0;font-weight:750}\n#unidavi-cp2-grandiuva .uv-section-header span{color:#7d8b98;font-size:11px}\n#unidavi-cp2-grandiuva .uv-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}\n#unidavi-cp2-grandiuva .uv-card{min-width:0;background:#fff;border:1px solid #e3e9ee;border-radius:14px;padding:18px 15px 14px;box-shadow:0 4px 14px rgba(32,61,77,.04)}\n#unidavi-cp2-grandiuva .uv-card.uv-na{background:#fafafa}\n#unidavi-cp2-grandiuva .uv-card-label{font-size:10px;font-weight:800;letter-spacing:.6px;color:#687e8f;display:flex;align-items:center;gap:7px}\n#unidavi-cp2-grandiuva .uv-card-label span{font-size:18px}\n#unidavi-cp2-grandiuva .uv-big-value{font-size:37px;letter-spacing:-.9px;font-weight:800;color:#162c3f;padding:12px 0 7px;white-space:nowrap}\n#unidavi-cp2-grandiuva .uv-big-value span{font-size:15px;letter-spacing:0;margin-left:4px;color:#768994;font-weight:600}\n#unidavi-cp2-grandiuva .uv-mini-chart{height:57px;overflow:hidden;margin-top:8px}\n#unidavi-cp2-grandiuva .uv-mini-chart svg{display:block;width:100%;height:100%}\n#unidavi-cp2-grandiuva .uv-progress{height:5px;border-radius:5px;background:#e7eeec;overflow:hidden;margin:2px 0 8px}\n#unidavi-cp2-grandiuva .uv-progress>div{height:100%;background:#17a28b;border-radius:5px;transition:width .3s ease}\n#unidavi-cp2-grandiuva .uv-progress-sun>div{background:#e5a23c}\n#unidavi-cp2-grandiuva .uv-note{font-size:10px;color:#7c8b98;min-height:29px;margin-top:8px;line-height:1.4}\n#unidavi-cp2-grandiuva .uv-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}\n#unidavi-cp2-grandiuva .uv-box{background:#fff;border:1px solid #e3e9ee;border-radius:14px;padding:18px}\n#unidavi-cp2-grandiuva .uv-box h2{font-size:15px;margin-bottom:13px;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}\n#unidavi-cp2-grandiuva .uv-box h2 small{font-size:10px;font-weight:500;color:#8593a0}\n#unidavi-cp2-grandiuva .uv-act{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-top:1px solid #edf0f1;gap:10px}\n#unidavi-cp2-grandiuva .uv-act>div{display:flex;align-items:center;gap:8px}\n#unidavi-cp2-grandiuva .uv-act>div span{font-size:19px}\n#unidavi-cp2-grandiuva .uv-act strong{font-size:12px}\n#unidavi-cp2-grandiuva .uv-act small{color:#8a9aa4;font-size:10px}\n#unidavi-cp2-grandiuva .uv-act b{font-size:10px;font-weight:800;padding:6px 9px;border-radius:18px;background:#edf1f3;color:#6a7a82;white-space:nowrap}\n#unidavi-cp2-grandiuva .uv-act b.uv-on{color:#0f755e;background:#d9f8e8}\n#unidavi-cp2-grandiuva .uv-info{padding:10px 0;border-top:1px solid #edf0f1;display:flex;justify-content:space-between;gap:10px;align-items:center}\n#unidavi-cp2-grandiuva .uv-info span{font-size:11px;color:#788996}\n#unidavi-cp2-grandiuva .uv-info strong{font-size:11px;text-align:right}\n#unidavi-cp2-grandiuva .uv-api{background:#f3f7f7;border-radius:9px;padding:11px;margin-top:9px;font-size:11px;line-height:1.8}\n#unidavi-cp2-grandiuva .uv-api code{font-size:10px;word-break:break-word;color:#187c6b}\n#unidavi-cp2-grandiuva .uv-footer{margin:13px 4px 0;font-size:10px;color:#7d8d96;text-align:center}\n@media(max-width:700px){#unidavi-cp2-grandiuva .uv-metrics{grid-template-columns:1fr}#unidavi-cp2-grandiuva .uv-details{grid-template-columns:1fr}#unidavi-cp2-grandiuva .uv-big-value{font-size:33px}}\n@media(max-width:460px){#unidavi-cp2-grandiuva .uv-plant-row{grid-template-columns:1fr}#unidavi-cp2-grandiuva .uv-hero{padding:18px}#unidavi-cp2-grandiuva .uv-card{padding:15px}}\n</style>",
