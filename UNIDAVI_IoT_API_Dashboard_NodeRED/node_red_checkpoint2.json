  {
    "id": "e0261109a1000093",
    "type": "ui_template",
    "z": "e0261109a1000001",
    "group": "e0261109a1000092",
    "name": "CP2 - Araucaria",
    "order": 1,
    "width": "16",
    "height": "0",
    "format": "<div id=\"unidavi-cp2-araucaria\" class=\"uv-shell\">\n  <div class=\"uv-hero\">\n    <div>\n      <div class=\"uv-overline\">UNIDAVI · PROJETO FINAL IOT</div>\n      <h1>Monitoramento das plantas</h1>\n      <p>Arduino Mega 2560 + ESP8266 · Sensores via MQTT</p>\n    </div>\n    <div class=\"uv-top-flags\">\n      <span class=\"uv-pill\" ng-class=\"{'uv-live': status === 'Atualizando', 'uv-test': status === 'Simulação', 'uv-stale': status === 'Sem atualização' || status === 'Offline / não selecionada'}\">{{status}}</span>\n      <span class=\"uv-pill uv-data-test\" ng-if=\"atual && atual.origem === 'simulacao'\">DADOS DE TESTE</span>\n    </div>\n  </div>\n\n  <div class=\"uv-plants\">\n    <span class=\"uv-eyebrow\">ESPECIE DESTE GRUPO</span>\n    <div class=\"uv-plant-row\">\n      <div class=\"uv-plant\" ng-class=\"{'uv-active': atual && atual.planta === 'Araucaria'}\">\n        <span class=\"uv-plant-icon\">🌲</span><div><strong>Araucária</strong><small>Umidade mínima: 35%</small></div>\n      </div>\n      <div class=\"uv-plant\" ng-class=\"{'uv-active': atual && atual.planta === 'Grandiuva'}\">\n        <span class=\"uv-plant-icon\">🌿</span><div><strong>Grandiúva</strong><small>Umidade mínima: 30%</small></div>\n      </div>\n    </div>\n    <div class=\"uv-plant-help\">Kit compartilhado: o botão D30 seleciona a espécie. O outro grupo mantém a última leitura, sem atualização.</div>\n  </div>\n\n  <div class=\"uv-section-header\"><h2>Leituras dos sensores</h2><span>MQTT: publicação prevista a cada 10 segundos</span></div>\n  <div class=\"uv-metrics\">\n    <div class=\"uv-card\">\n      <div class=\"uv-card-label\"><span>🌡️</span> TEMPERATURA DO AR</div>\n      <div class=\"uv-big-value\">{{valorTemperatura}}<span ng-if=\"valorTemperatura !== '—'\">°C</span></div>\n      <div class=\"uv-mini-chart\"><svg viewBox=\"0 0 280 66\" preserveAspectRatio=\"none\" aria-label=\"Tendência da temperatura\">\n        <polyline ng-if=\"sparkTemperatura\" ng-attr-points=\"{{sparkTemperatura}}\" stroke=\"#3B82F6\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"></polyline>\n        <line ng-if=\"!sparkTemperatura\" x1=\"0\" y1=\"33\" x2=\"280\" y2=\"33\" stroke=\"#cbd5e1\" stroke-dasharray=\"5 6\" stroke-width=\"2\"></line>\n      </svg></div>\n      <div class=\"uv-note\">Araucária: aquecimento abaixo de 10 °C</div>\n    </div>\n    <div class=\"uv-card\">\n      <div class=\"uv-card-label\"><span>💧</span> UMIDADE DO SOLO</div>\n      <div class=\"uv-big-value\">{{valorSolo}}<span ng-if=\"unidadeSolo\">%</span></div>\n      <div class=\"uv-progress\"><div ng-style=\"{'width': percentualSolo + '%'}\"></div></div>\n      <div class=\"uv-mini-chart\"><svg viewBox=\"0 0 280 66\" preserveAspectRatio=\"none\" aria-label=\"Tendência da umidade\">\n        <polyline ng-if=\"sparkSolo\" ng-attr-points=\"{{sparkSolo}}\" stroke=\"#0D9A83\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"></polyline>\n        <line ng-if=\"!sparkSolo\" x1=\"0\" y1=\"33\" x2=\"280\" y2=\"33\" stroke=\"#cbd5e1\" stroke-dasharray=\"5 6\" stroke-width=\"2\"></line>\n      </svg></div>\n      <div class=\"uv-note\">Irrigação abaixo de {{limiarSolo}}</div>\n    </div>\n    <div class=\"uv-card\" ng-class=\"{'uv-na': atual && atual.planta === 'Araucaria'}\">\n      <div class=\"uv-card-label\"><span>☀️</span> LUMINOSIDADE</div>\n      <div class=\"uv-big-value\">{{valorLuz}}<span ng-if=\"unidadeLuz\">%</span></div>\n      <div class=\"uv-progress uv-progress-sun\"><div ng-style=\"{'width': percentualLuz + '%'}\"></div></div>\n      <div class=\"uv-mini-chart\"><svg viewBox=\"0 0 280 66\" preserveAspectRatio=\"none\" aria-label=\"Tendência da luminosidade\">\n        <polyline ng-if=\"sparkLuz\" ng-attr-points=\"{{sparkLuz}}\" stroke=\"#E6A341\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"></polyline>\n        <line ng-if=\"!sparkLuz\" x1=\"0\" y1=\"33\" x2=\"280\" y2=\"33\" stroke=\"#cbd5e1\" stroke-dasharray=\"5 6\" stroke-width=\"2\"></line>\n      </svg></div>\n      <div class=\"uv-note\">{{notaLuz}}</div>\n    </div>\n  </div>\n\n  <div class=\"uv-details\">\n    <div class=\"uv-box\">\n      <h2>Estados dos atuadores <small>LEDs do protótipo</small></h2>\n      <div class=\"uv-act\"><div><span>♨️</span><strong>Aquecedor</strong><small>D22</small></div><b ng-class=\"{'uv-on': atual && atual.aquecedor}\">{{estadoAquecedor}}</b></div>\n      <div class=\"uv-act\"><div><span>🚿</span><strong>Bomba de irrigação</strong><small>D24</small></div><b ng-class=\"{'uv-on': atual && atual.bomba}\">{{estadoBomba}}</b></div>\n      <div class=\"uv-act\"><div><span>⛱️</span><strong>Sombreamento</strong><small>D26</small></div><b ng-class=\"{'uv-on': atual && atual.sombreamento}\">{{estadoSombra}}</b></div>\n    </div>\n    <div class=\"uv-box\">\n      <h2>Informações da telemetria <small>{{origem}}</small></h2>\n      <div class=\"uv-info\"><span>Último pacote recebido</span><strong>{{ultimaAtualizacao}}</strong></div>\n      <div class=\"uv-info\"><span>Tempo desde a leitura</span><strong>{{idade}}</strong></div>\n      <div class=\"uv-info\"><span>Histórico exibido</span><strong>{{qtdHistorico}} amostras recentes</strong></div>\n      <div class=\"uv-info\"><span>Transmissão</span><strong>MQTT · porta 1883</strong></div>\n      <div class=\"uv-api\">API JSON: <code>GET /api/plantas/atual</code> e <code>GET /api/plantas/historico</code></div>\n    </div>\n  </div>\n  <div class=\"uv-footer\">Leituras e estados apenas para visualização. Os LEDs são controlados localmente pelo Arduino.</div>\n</div>\n\n<script>\n(function(scope) {\n  // O Dashboard 1.x utiliza AngularJS (nao Vue / Dashboard 2.0).\n  function fmt(n) { return typeof n === 'number' && isFinite(n) ? n.toFixed(1).replace('.', ',') : '—'; }\n  function pontos(hist, planta, campo) {\n    var itens = (hist || []).filter(function(d) {\n      return d && d.planta === planta && typeof d[campo] === 'number' && isFinite(d[campo]);\n    }).slice(-28);\n    if (itens.length < 2) return '';\n    var valores = itens.map(function(d) { return d[campo]; });\n    var baixo = campo === 'temperatura' ? Math.min.apply(null, valores) - 1 : 0;\n    var alto = campo === 'temperatura' ? Math.max.apply(null, valores) + 1 : 100;\n    if (alto - baixo < 1) alto = baixo + 1;\n    return valores.map(function(v, i) {\n      var x = 5 + i * (270 / (valores.length - 1));\n      var y = 57 - (v - baixo) * 48 / (alto - baixo);\n      return x.toFixed(1) + ',' + y.toFixed(1);\n    }).join(' ');\n  }\n  function desenhar(msg) {\n    var dados = msg && msg.payload && typeof msg.payload === 'object' ? msg.payload : {};\n    var atual = dados.atual || null;\n    var hist = Array.isArray(dados.historico) ? dados.historico : [];\n    scope.atual = atual;\n    scope.qtdHistorico = hist.length;\n    scope.valorTemperatura = atual ? fmt(atual.temperatura) : '—';\n    scope.valorSolo = atual && atual.soloValido && atual.umidadeSolo !== null ? fmt(atual.umidadeSolo) : '—';\n    scope.valorLuz = !atual ? '—' : atual.planta === 'Araucaria' ? 'N/A' : atual.luzValida && atual.luminosidade !== null ? fmt(atual.luminosidade) : '—';\n    scope.unidadeSolo = !!(atual && atual.soloValido && typeof atual.umidadeSolo === 'number');\n    scope.unidadeLuz = !!(atual && atual.planta === 'Grandiuva' && atual.luzValida && typeof atual.luminosidade === 'number');\n    scope.percentualSolo = scope.unidadeSolo ? atual.umidadeSolo : 0;\n    scope.percentualLuz = scope.unidadeLuz ? atual.luminosidade : 0;\n    scope.limiarSolo = atual ? atual.limiarSolo + '%' : '35% (Araucária) / 30% (Grandiúva)';\n    scope.notaLuz = !atual ? 'Aguardando dados do sensor' : atual.planta === 'Araucaria' ? 'Não aplicável à Araucária' : atual.luzValida ? 'Sombreamento acima de 90%' : 'LDR não calibrado';\n    scope.estadoAquecedor = !atual || atual.aquecedor === null ? '—' : atual.aquecedor ? 'LIGADO' : 'DESLIGADO';\n    scope.estadoBomba = !atual || atual.bomba === null ? '—' : atual.bomba ? 'LIGADA' : 'DESLIGADA';\n    scope.estadoSombra = !atual || atual.sombreamento === null ? '—' : atual.sombreamento ? 'LIGADO' : 'DESLIGADO';\n    scope.origem = !atual ? 'Aguardando dados' : atual.origem === 'simulacao' ? 'Simulação' : 'Recebido por MQTT';\n    var instante = atual && atual.recebidoEm ? Date.parse(atual.recebidoEm) : NaN;\n    var idadeMs = isFinite(instante) ? Math.max(0, Date.now() - instante) : NaN;\n    scope.idade = isFinite(idadeMs) ? Math.floor(idadeMs / 1000) + ' s' : '—';\n    scope.ultimaAtualizacao = isFinite(instante) ? new Date(instante).toLocaleString('pt-BR') : '—';\n    scope.status = !atual || !atual.recebidoEm ? 'Aguardando dados' : atual.mqttOnline === false ? 'Offline / não selecionada' : !isFinite(idadeMs) || idadeMs > 30000 ? 'Sem atualização' : 'Atualizando';\n    var planta = atual && atual.planta;\n    scope.sparkTemperatura = pontos(hist, planta, 'temperatura');\n    scope.sparkSolo = pontos(hist, planta, 'umidadeSolo');\n    scope.sparkLuz = planta === 'Grandiuva' ? pontos(hist, planta, 'luminosidade') : '';\n  }\n  desenhar(null);\n  scope.$watch('msg', function(msg) { if (msg) desenhar(msg); });\n})(scope);\n</script>\n\n<style>\n#unidavi-cp2-araucaria.uv-shell {font-family:Roboto,'Segoe UI',Arial,sans-serif;color:#21314a;box-sizing:border-box;padding:4px 2px 12px}\n#unidavi-cp2-araucaria * {box-sizing:border-box}\n#unidavi-cp2-araucaria .uv-hero {display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:26px;border-radius:18px;background:linear-gradient(116deg,#112e34,#126457);color:#fff}\n#unidavi-cp2-araucaria .uv-overline {font-size:10px;font-weight:800;letter-spacing:2px;color:#9ee8cc;margin-bottom:8px}\n#unidavi-cp2-araucaria h1 {margin:0 0 8px;font-size:26px;font-weight:800;line-height:1.15;letter-spacing:-.5px}\n#unidavi-cp2-araucaria .uv-hero p{margin:0;color:#d4eee5;font-size:12px}\n#unidavi-cp2-araucaria .uv-top-flags{display:flex;gap:8px;flex-wrap:wrap}\n#unidavi-cp2-araucaria .uv-pill{border-radius:22px;padding:8px 11px;font-weight:750;font-size:11px;background:rgba(255,255,255,.15);white-space:nowrap}\n#unidavi-cp2-araucaria .uv-pill.uv-live{color:#95f3d0}\n#unidavi-cp2-araucaria .uv-pill.uv-test{color:#ffe3a0}\n#unidavi-cp2-araucaria .uv-pill.uv-stale{color:#ffbaa6}\n#unidavi-cp2-araucaria .uv-pill.uv-data-test{border:1px solid rgba(255,255,255,.4)}\n#unidavi-cp2-araucaria .uv-plants{background:#fff;border:1px solid #dfe8e6;border-radius:14px;padding:17px 20px;margin-top:14px}\n#unidavi-cp2-araucaria .uv-eyebrow{font-size:10px;letter-spacing:1.3px;font-weight:750;color:#6a7b85}\n#unidavi-cp2-araucaria .uv-plant-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:10px}\n#unidavi-cp2-araucaria .uv-plant{display:flex;align-items:center;gap:12px;border-radius:11px;border:2px solid #edf0f0;padding:12px;color:#758590;background:#fafcfc;opacity:.78}\n#unidavi-cp2-araucaria .uv-plant.uv-active{border-color:#168873;background:#ebfaf5;color:#184f46;opacity:1}\n#unidavi-cp2-araucaria .uv-plant-icon{font-size:25px;line-height:1.2}\n#unidavi-cp2-araucaria .uv-plant strong,#unidavi-cp2-araucaria .uv-plant small{display:block}\n#unidavi-cp2-araucaria .uv-plant strong{font-size:14px}\n#unidavi-cp2-araucaria .uv-plant small{font-size:11px;margin-top:4px}\n#unidavi-cp2-araucaria .uv-plant-help{margin-top:10px;color:#758590;font-size:10px}\n#unidavi-cp2-araucaria .uv-section-header{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin:20px 0 11px}\n#unidavi-cp2-araucaria h2{font-size:17px;margin:0;font-weight:750}\n#unidavi-cp2-araucaria .uv-section-header span{color:#7d8b98;font-size:11px}\n#unidavi-cp2-araucaria .uv-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}\n#unidavi-cp2-araucaria .uv-card{min-width:0;background:#fff;border:1px solid #e3e9ee;border-radius: