    "func": "const especies = flow.get('plantasPorEspecie') || {};\nconst historico = flow.get('plantasHistorico') || [];\nreturn [Object.values(especies).map(atual => ({payload: {atual, historico: historico.filter(d => d.planta === atual.planta).slice(-50)}}))];",
